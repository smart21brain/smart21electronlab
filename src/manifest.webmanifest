{
  "name": "Smart21 ElectroLab",
  "short_name": "ElectroLab",
  "description": "Circuit simulator and Arduino emulator for studying electronics",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e1411",
  "theme_color": "#0f7a5a",
  "icons": [
    {
      "src": "img/appicon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "img/appicon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "img/appicon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [
          ".s21lab"
        ]
      }
    }
  ]
}