{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart21electronlab",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./src",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": { "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct" }
}
